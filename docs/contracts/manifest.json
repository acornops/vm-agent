{
  "repo": "agentv",
  "version": 1,
  "runtimeDependencies": ["control-plane"],
  "systemdRelease": {
    "assets": [
      "install-agentv.sh",
      "install-agentv.sh.sha256",
      "agentv-<version>.tar.gz",
      "agentv-<version>.tar.gz.sha256",
      "agentv-<version>.spdx.json"
    ],
    "layout": "<release-base-url>/v<version>/<asset>",
    "bootstrapConfig": ["platformUrl", "targetId", "enrollmentToken?", "replaceCredential?"]
  },
  "counterparts": {
    "control-plane": {
      "contractVersion": 2,
      "agentHeaders": ["x-agent-key", "x-connector-version"],
      "connectorVersionHeader": "agentv/<package-version>; required, validated against agentType, and persisted as last_connector_version",
      "handshakeRequestFields": [
        "targetId", "targetType", "agentType",
        "supportedCapabilities", "hostFeatures.osFamily", "hostFeatures.serviceManager",
        "hostFeatures.helperReachable", "hostFeatures.restartServices",
        "advertisedTools[].name", "advertisedTools[].capability"
      ],
      "handshakeResponseFields": [
        "workspaceId", "targetId", "targetType", "provisional?", "sessionPolicy.allowedTools",
        "sessionPolicy.writeEnabled", "config.snapshotInterval", "config.maxSnapshotBytes"
      ],
      "snapshotFields": [
        "schema_version", "host_summary", "filesystems[]", "degraded_services[]",
        "top_processes[]", "listeners[]", "findings[]", "collector_health[]", "truncation"
      ],
      "rpcMethods": ["tools/list", "tools/call"],
      "toolDefinitionFields": ["inputSchema", "outputSchema", "artifactPolicy", "timeout_ms", "version", "deprecated"],
      "toolResultSchemas": ["acornops.full-tool-result.v1", "acornops.model-context.v1"],
      "builtinToolNames": [
        "get_host_summary", "list_filesystems", "list_processes", "get_process",
        "list_services", "get_service", "query_logs", "list_listeners", "restart_service"
      ]
    }
  }
}
